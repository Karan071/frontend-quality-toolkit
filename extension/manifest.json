{
  "manifest_version": 3,
  "name": "Frontend Quality Toolkit",
  "version": "0.1.4",
  "description": "Audit any page for layout, responsiveness, performance, images, accessibility and UI issues. Preview fixes and capture screenshots.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Frontend Toolkit",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "service-worker.js" },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "debugger",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
