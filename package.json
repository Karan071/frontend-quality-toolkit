{
  "name": "frontend-quality-toolkit",
  "version": "0.1.3",
  "private": true,
  "description": "Chrome MV3 side-panel toolkit: inspect, measure, audit, fix, verify and capture.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node tests/e2e/run.mjs",
    "e2e:prod": "npm run build && node tests/e2e/prod.mjs",
    "validate": "npm run build && node tests/e2e/validate.mjs",
    "validate:live": "npm run build && node tests/e2e/validate.mjs --live",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ftk/accessibility-analyzer": "workspace:*",
    "@ftk/asset-extractor": "workspace:*",
    "@ftk/audit-core": "workspace:*",
    "@ftk/bundle-analyzer": "workspace:*",
    "@ftk/color-analyzer": "workspace:*",
    "@ftk/css-analyzer": "workspace:*",
    "@ftk/dom-analyzer": "workspace:*",
    "@ftk/image-analyzer": "workspace:*",
    "@ftk/layout-analyzer": "workspace:*",
    "@ftk/performance-analyzer": "workspace:*",
    "@ftk/recommendation-engine": "workspace:*",
    "@ftk/responsive-analyzer": "workspace:*",
    "@ftk/screenshot-engine": "workspace:*",
    "@ftk/typography-analyzer": "workspace:*",
    "@ftk/ux-analyzer": "workspace:*",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
